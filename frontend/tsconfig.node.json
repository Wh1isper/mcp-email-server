{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "types": ["node"]
    },
    "include": [
        "vite.config.ts",
        "eslint.config.js",
        "playwright.config.ts",
        "e2e/**/*.ts"
    ]
}
